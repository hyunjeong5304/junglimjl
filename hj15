    <!-- Scripts -->
    <script>
        // 1. Initialize Lucide Icons
        lucide.createIcons();

        // 2. Handle Header Scroll Effect
        const header = document.getElementById('header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header.classList.remove('py-6', 'border-white/0');
                header.classList.add('py-4', 'bg-dark/90', 'backdrop-blur-md', 'border-white/10');
            } else {
                header.classList.remove('py-4', 'bg-dark/90', 'backdrop-blur-md', 'border-white/10');
                header.classList.add('py-6', 'border-white/0');
            }
        });

        // 3. Handle Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuLinks = document.querySelectorAll('.menu-link');
        const menuIcon = document.getElementById('menu-icon');
        let isMenuOpen = false;

        function toggleMenu() {
            isMenuOpen = !isMenuOpen;
            if (isMenuOpen) {
                mobileMenu.classList.remove('-translate-y-full');
                mobileMenu.classList.add('translate-y-0');
                menuIcon.setAttribute('data-lucide', 'x');
            } else {
                mobileMenu.classList.remove('translate-y-0');
                mobileMenu.classList.add('-translate-y-full');
                menuIcon.setAttribute('data-lucide', 'menu');
            }
            lucide.createIcons();
        }

        menuBtn.addEventListener('click', toggleMenu);
        menuLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (isMenuOpen) toggleMenu();
            });
        });

        // 4. Guestbook functionality
        const guestbookForm = document.getElementById('guestbook-form');
        const guestbookEntries = document.getElementById('guestbook-entries');

        if (guestbookForm) {
            guestbookForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const nameInput = document.getElementById('gb-name').value;
                const messageInput = document.getElementById('gb-message').value.replace(/\n/g, '<br>');
                
                const today = new Date();
                const year = today.getFullYear();
                const month = String(today.getMonth() + 1).padStart(2, '0');
                const day = String(today.getDate()).padStart(2, '0');
                const formattedDate = `${year}. ${month}. ${day}`;

                const newEntry = document.createElement('div');
                newEntry.className = 'bg-surface/50 p-6 border border-white/5 rounded-sm animate-fade-up';
                newEntry.innerHTML = `
                    <div class="flex justify-between items-start mb-4">
                        <span class="font-bold text-white/90">${nameInput}</span>
                        <span class="font-outfit text-xs text-white/30 tracking-widest">${formattedDate}</span>
                    </div>
                    <p class="text-white/60 font-light leading-relaxed text-sm">${messageInput}</p>
                `;

                guestbookEntries.insertBefore(newEntry, guestbookEntries.firstChild);
                guestbookForm.reset();
            });
        }

        // 5. Set dynamic copyright year
        document.getElementById('copyright-year').innerHTML = `&copy; ${new Date().getFullYear()} HYUNJUNG NOH ARCHITECTURE STUDIO.`;
    </script>
</body>
