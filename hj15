<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hyunjung Noh | Architecture Studio</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }
        /* Custom Selection Color */
        ::selection {
            background-color: #111827; /* gray-900 */
            color: #ffffff;
        }
    </style>
</head>
<body class="bg-[#FCFCFC] text-gray-900 font-sans min-h-screen">
    
    <!-- Header -->
    <header id="header" class="fixed w-full z-50 transition-all duration-500 bg-transparent py-8">
        <div class="max-w-7xl mx-auto px-6 md:px-12 flex justify-between items-center">
            <a href="#" class="flex flex-col">
                <span class="font-serif text-xl tracking-widest text-gray-900 uppercase">Hyunjung Noh</span>
                <span class="text-[10px] tracking-[0.3em] text-gray-400 mt-1 uppercase">Architecture Studio</span>
            </a>
            
            <div class="hidden md:flex space-x-12 items-center">
                <a href="#vision" class="text-sm tracking-widest text-gray-500 hover:text-gray-900 transition-colors uppercase">Vision</a>
                <a href="#projects" class="text-sm tracking-widest text-gray-500 hover:text-gray-900 transition-colors uppercase">Projects</a>
                <a href="#contact" class="text-sm tracking-widest text-gray-500 hover:text-gray-900 transition-colors uppercase">Contact</a>
            </div>

            <button id="menu-btn" class="md:hidden text-gray-900 hover:opacity-70 transition-opacity">
                <i id="menu-icon" data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="fixed inset-0 bg-white z-40 transition-transform duration-500 ease-in-out -translate-y-full md:hidden flex flex-col justify-center items-center space-y-8">
        <a href="#vision" class="menu-link text-2xl font-serif tracking-widest uppercase hover:text-gray-500 transition-colors">Vision</a>
        <a href="#projects" class="menu-link text-2xl font-serif tracking-widest uppercase hover:text-gray-500 transition-colors">Projects</a>
        <a href="#contact" class="menu-link text-2xl font-serif tracking-widest uppercase hover:text-gray-500 transition-colors">Contact</a>
    </div>

    <!-- Hero Section -->
    <section class="relative pt-32 md:pt-40 pb-20 px-6 md:px-12 max-w-7xl mx-auto min-h-[90vh] flex flex-col md:flex-row items-center gap-12">
        <div class="w-full md:w-1/2 z-10">
            <p class="text-xs tracking-[0.4em] text-gray-400 mb-6 uppercase">Architectural Design</p>
            <h1 class="text-5xl md:text-7xl font-serif leading-[1.1] mb-8 text-gray-900">
                공간에<br />
                <span class="italic text-gray-500">시간의 깊이</span>를<br />
                담아냅니다.
            </h1>
            <p class="text-lg text-gray-600 font-light leading-relaxed max-w-md mb-12">
                건축가 노현정은 단순한 건물이 아닌, 삶의 배경이 되는 조화로운 공간을 설계합니다. 
                빛, 바람, 그리고 사람의 온기가 머무는 건축을 지향합니다.
            </p>
            <a href="#projects" class="inline-flex items-center gap-3 border-b border-gray-900 pb-2 hover:text-gray-500 hover:border-gray-500 transition-all uppercase tracking-widest text-sm">
                View Projects <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>
        
        <div class="w-full md:w-1/2 h-[60vh] md:h-[80vh] relative">
            <img 
                src="https://images.unsplash.com/photo-1513694203232-719a280e022f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" 
                alt="Architecture by Hyunjung Noh" 
                class="w-full h-full object-cover rounded-sm"
            >
            <div class="absolute -bottom-6 -left-6 bg-white p-8 shadow-sm hidden md:block">
                <p class="font-serif text-2xl">Hyunjung Noh</p>
                <p class="text-sm text-gray-500 mt-2 tracking-widest uppercase">Lead Architect</p>
            </div>
        </div>
    </section>

    <!-- Vision & About -->
    <section id="vision" class="py-32 px-6 md:px-12 bg-white">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="font-serif text-3xl md:text-4xl leading-relaxed text-gray-900 mb-12">
                "완벽한 건축은 더 이상 더할 것이 없을 때가 아니라,<br class="hidden md:block" />
                <span class="italic text-gray-400">더 이상 뺄 것이 없을 때</span> 완성됩니다."
            </h2>
            <div class="w-px h-16 bg-gray-300 mx-auto mb-12"></div>
            <p class="text-gray-600 font-light leading-loose text-lg md:text-xl">
                안녕하세요, 건축가 노현정입니다.<br />
                저의 설계는 공간을 사용하는 '사람'에 대한 깊은 이해에서 출발합니다. 
                불필요한 장식을 덜어내고 본질에 집중할 때, 비로소 장소는 고유한 생명력을 얻게 됩니다. 
                자연의 요소들이 실내로 자연스럽게 스며드는 공간, 시간이 지날수록 우아하게 나이 드는 건축을 추구합니다.
            </p>
        </div>
    </section>

    <!-- Projects Gallery (Staggered Grid) -->
    <section id="projects" class="py-32 px-6 md:px-12 max-w-7xl mx-auto">
        <div class="flex justify-between items-end mb-16 border-b border-gray-200 pb-6">
            <h2 class="font-serif text-4xl text-gray-900">Selected Works</h2>
            <span class="text-sm tracking-widest text-gray-400 uppercase">2023 - 2025</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24">
            
            <!-- Project 01 -->
            <div class="group cursor-pointer">
                <div class="overflow-hidden mb-6 relative">
                    <img 
                        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                        alt="아오의 서재" 
                        class="w-full aspect-[4/5] object-cover transform group-hover:scale-105 transition-transform duration-1000 ease-out"
                    >
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500"></div>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs tracking-[0.2em] text-gray-400 uppercase block mb-2">Private Library & Residence</span>
                        <h3 class="font-serif text-2xl text-gray-900 group-hover:text-gray-500 transition-colors">아오의 서재</h3>
                    </div>
                    <span class="font-mono text-sm text-gray-400">2025</span>
                </div>
            </div>

            <!-- Project 02 (Staggered: md:mt-32) -->
            <div class="group cursor-pointer md:mt-32">
                <div class="overflow-hidden mb-6 relative">
                    <img 
                        src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                        alt="빛무늬 갤러리" 
                        class="w-full aspect-[4/5] object-cover transform group-hover:scale-105 transition-transform duration-1000 ease-out"
                    >
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500"></div>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs tracking-[0.2em] text-gray-400 uppercase block mb-2">Art Museum</span>
                        <h3 class="font-serif text-2xl text-gray-900 group-hover:text-gray-500 transition-colors">빛무늬 갤러리</h3>
                    </div>
                    <span class="font-mono text-sm text-gray-400">2024</span>
                </div>
            </div>

            <!-- Project 03 -->
            <div class="group cursor-pointer">
                <div class="overflow-hidden mb-6 relative">
                    <img 
                        src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                        alt="선과 면의 집" 
                        class="w-full aspect-[4/5] object-cover transform group-hover:scale-105 transition-transform duration-1000 ease-out"
                    >
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500"></div>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs tracking-[0.2em] text-gray-400 uppercase block mb-2">Single Family Home</span>
                        <h3 class="font-serif text-2xl text-gray-900 group-hover:text-gray-500 transition-colors">선과 면의 집</h3>
                    </div>
                    <span class="font-mono text-sm text-gray-400">2024</span>
                </div>
            </div>

            <!-- Project 04 (Staggered: md:mt-32) -->
            <div class="group cursor-pointer md:mt-32">
                <div class="overflow-hidden mb-6 relative">
                    <img 
                        src="https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                        alt="도심 속 정원" 
                        class="w-full aspect-[4/5] object-cover transform group-hover:scale-105 transition-transform duration-1000 ease-out"
                    >
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500"></div>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs tracking-[0.2em] text-gray-400 uppercase block mb-2">Commercial Space</span>
                        <h3 class="font-serif text-2xl text-gray-900 group-hover:text-gray-500 transition-colors">도심 속 정원</h3>
                    </div>
                    <span class="font-mono text-sm text-gray-400">2023</span>
                </div>
            </div>

        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-32 px-6 md:px-12 bg-gray-900 text-white text-center">
        <div class="max-w-3xl mx-auto">
            <p class="text-xs tracking-[0.4em] text-gray-400 mb-8 uppercase">Start a Project</p>
            <h2 class="font-serif text-5xl md:text-6xl mb-12">새로운 프로젝트를<br/>함께 구상해 보세요.</h2>
            
            <div class="flex flex-col md:flex-row justify-center items-center gap-8 mb-16">
                <a href="mailto:contact@hyunjung-noh.com" class="group flex items-center gap-3 text-lg font-light hover:text-gray-300 transition-colors">
                    <i data-lucide="mail" class="w-5 h-5 text-gray-500 group-hover:text-gray-300 transition-colors"></i>
                    contact@hyunjung-noh.com
                </a>
            </div>

            <a href="mailto:contact@hyunjung-noh.com" class="inline-block border border-white/30 px-10 py-4 uppercase tracking-widest text-sm hover:bg-white hover:text-gray-900 transition-all duration-300">
                문의하기
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-6 md:px-12 border-t border-gray-200 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="text-xs tracking-widest text-gray-400 uppercase" id="copyright-year">
            <!-- Year injected via JS -->
        </div>
        <div class="flex gap-6">
            <a href="#" class="text-gray-400 hover:text-gray-900 transition-colors">
                <i data-lucide="instagram" class="w-5 h-5"></i>
            </a>
        </div>
    </footer>

    <!-- Scripts for Interactions -->
    <script>
        // 1. Initialize Lucide Icons
        lucide.createIcons();

        // 2. Handle Header Scroll Effect
        const header = document.getElementById('header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header.classList.remove('bg-transparent', 'py-8');
                header.classList.add('bg-white/90', 'backdrop-blur-md', 'py-4', 'shadow-sm');
            } else {
                header.classList.remove('bg-white/90', 'backdrop-blur-md', 'py-4', 'shadow-sm');
                header.classList.add('bg-transparent', 'py-8');
            }
        });

        // 3. Handle Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuLinks = document.querySelectorAll('.menu-link');
        const menuIcon = document.getElementById('menu-icon');
        let isMenuOpen = false;

        function toggleMenu() {
            isMenuOpen = !isMenuOpen;
            if (isMenuOpen) {
                mobileMenu.classList.remove('-translate-y-full');
                mobileMenu.classList.add('translate-y-0');
                menuIcon.setAttribute('data-lucide', 'x');
            } else {
                mobileMenu.classList.remove('translate-y-0');
                mobileMenu.classList.add('-translate-y-full');
                menuIcon.setAttribute('data-lucide', 'menu');
            }
            // Re-render icon
            lucide.createIcons();
        }

        menuBtn.addEventListener('click', toggleMenu);
        
        // Close menu when a link is clicked
        menuLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (isMenuOpen) toggleMenu();
            });
        });

        // 4. Set dynamic copyright year
        document.getElementById('copyright-year').innerHTML = `&copy; ${new Date().getFullYear()} Hyunjung Noh Architecture.`;
    </script>
</body>
</html>
